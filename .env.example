# IntelliMetrics AI settings.  Copy this file to ".env" and edit it.  NEVER commit ".env" (it is in .gitignore).
# Running locally with no Docker?  You do not need this file at all: everything has a safe default.

# ---- basics -------------------------------------------------------------------------
ENV=development
# Long random text (32+ characters) used to sign logins. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# Optional key that protects saved database-connection passwords. Empty = derived from SECRET_KEY.
ENCRYPTION_KEY=
# Address of the web page (used in password-reset links). Local dev: http://localhost:5173  Docker: http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Set true only when the site is served over HTTPS
COOKIE_SECURE=false
# Create the demo companies, users and 62,000-row Indian sales data when the database is empty
AUTO_SEED=true

# ---- AI (optional; keys stay on the server and are never sent to the browser) ---------
# none   = TARA works in offline mode, no key needed (default)
# openai = set OPENAI_API_KEY      gemini = set GEMINI_API_KEY
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- database and background jobs (optional) ------------------------------------------
# Default: a local SQLite file, nothing to install. For PostgreSQL uncomment and edit:
# DATABASE_URL=postgresql://user:password@localhost:5432/intellimetrics
# Process uploads with Celery + Redis instead of a background thread:
# USE_CELERY=true
# REDIS_URL=redis://localhost:6379/0

# ---- Docker Compose only --------------------------------------------------------------
POSTGRES_USER=intellimetrics
POSTGRES_PASSWORD=change-me
POSTGRES_DB=intellimetrics
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ---- safety limits --------------------------------------------------------------------
QUERY_TIMEOUT_SECONDS=20
QUERY_ROW_LIMIT=10000
MAX_UPLOAD_MB=500
