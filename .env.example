# Copy to .env and edit. Never commit .env.
ENV=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# Optional Fernet key for connection-credential encryption; derived from SECRET_KEY when empty.
ENCRYPTION_KEY=
POSTGRES_USER=intellimetrics
POSTGRES_PASSWORD=change-me
POSTGRES_DB=intellimetrics
FRONTEND_PORT=3000
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Set true behind HTTPS
COOKIE_SECURE=false
# Seed demo workspaces + 62k-row sales data on first start (set false in real production)
AUTO_SEED=true
# openai | gemini | none  (none => TARA offline deterministic mode)
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
QUERY_TIMEOUT_SECONDS=20
QUERY_ROW_LIMIT=10000
MAX_UPLOAD_MB=500
